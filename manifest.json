{
  "manifest_version": 3,
  "name": "Meet AI Translator",
  "description": "Dịch phụ đề Google Meet theo thời gian thực bằng Gemini AI",
  "version": "1.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://meet.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet AI Translator — Cài đặt"
  },
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*"
      ],
      "js": [
        "constants.js",
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}